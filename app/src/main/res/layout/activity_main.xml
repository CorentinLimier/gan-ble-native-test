<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Shown only while disconnected: everything needed to find/configure/connect. -->
    <LinearLayout
        android:id="@+id/preConnectGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAN BLE Native Test"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Connects directly via BluetoothGatt to test native-only BLE controls against the hang/stall seen over Web Bluetooth. Scan to see every nearby BLE device (not just GAN ones) and tap one to fill in its MAC. Logs go to Android Studio's Logcat (tag GanBleNativeTest), not shown in-app."
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan for devices" />

        <ListView
            android:id="@+id/lvDevices"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etMac"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cube MAC address"
            android:inputType="textCapCharacters"
            android:text="FB:DD:7A:63:A3:20" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutoConnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="autoConnect=true" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swConnPriority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="requestConnectionPriority(HIGH)" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swRefreshCache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="gatt.refresh() before discovery" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swRequestMtu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="requestMtu(247)" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swLogNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Log every notification to Logcat (turn off if that's too noisy at a high notification rate)" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Connect" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Disconnected"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Shown only once connected and notifications are enabled. -->
    <LinearLayout
        android:id="@+id/postConnectGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disconnect" />

            <Button
                android:id="@+id/btnResetGyro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reset gyro" />

            <Button
                android:id="@+id/btnResetCube"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reset cube" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvServiceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>

    <com.corentinlimier.ganblenativetest.CubeView
        android:id="@+id/cubeView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
